[Unit]
Description=Music School Lesson Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=music
Group=music
WorkingDirectory=/opt/music-school
EnvironmentFile=/etc/music-school.env
ExecStartPre=/opt/music-school/.venv/bin/python scripts/init_db.py
ExecStart=/opt/music-school/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100
Restart=always
RestartSec=5

# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/music-school

[Install]
WantedBy=multi-user.target
