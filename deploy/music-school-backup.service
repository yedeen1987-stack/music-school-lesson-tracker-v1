[Unit]
Description=Music School - SQLite 每日备份
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/ugreen

[Service]
Type=oneshot
User=music
Group=music
WorkingDirectory=/opt/music-school
EnvironmentFile=/etc/music-school.env
UMask=0077
ExecStart=/opt/music-school/.venv/bin/python scripts/backup_sqlite.py
