# 复制到服务器上的 /etc/music-school.env，按实际情况填写，不要提交到 GitHub。

# 会话签名密钥，必须改成随机值：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-random-string

# SQLite 数据库位置（自建服务器建议放在独立数据目录，便于备份）
DATABASE_URL=/var/lib/music-school/music_school.sqlite3

# 服务器时区，影响“今日课程”和确认时间
TZ=America/Sao_Paulo

# 邮件发送（推荐用 Resend / Brevo / SendGrid 的 SMTP，比个人邮箱送达率高）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=Music School <no-reply@yourdomain.com>

# 应用内邮件队列后台线程：1 开启，0 关闭（关闭时改用 systemd timer 跑 scripts/process_email_queue.py）
EMAIL_WORKER_ENABLED=0
EMAIL_WORKER_INTERVAL=20

# 可选异地备份：为空或不配置时仅保留本地备份；须先安装并配置 rclone
# BACKUP_RCLONE_REMOTE=school-remote:music-school/backups
# RCLONE_CONFIG=/var/lib/music-school/rclone.conf
# BACKUP_DIR=/var/lib/music-school/backups
# BACKUP_KEEP=30

# 可选 NAS 第二份备份
# BACKUP_NAS_MOUNT=/mnt/ugreen
# BACKUP_NAS_DIR=/mnt/ugreen/server-backups/music-school
